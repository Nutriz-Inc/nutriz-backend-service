{
  "openapi": "3.0.3",
  "info": {
    "title": "Nutriz Backend Service API",
    "description": "API REST do Nutriz: cadastro de usuárias/doadoras, gestão de doações de leite materno, etapas do processo de doação, pontos de doação, jobs internos (agenda de coleta/entrega) e dashboard de métricas.\n\nTodas as rotas são versionadas por grupo de acesso: `/public` (sem autenticação) e `/internal` (requer `Authorization: Bearer <token>` obtido em `/public/auth/login`). O cabeçalho `action-by`, usado internamente para autorização por tipo de usuário, é preenchido automaticamente pelo middleware a partir do token — não precisa ser enviado pelo cliente.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3333", "description": "Ambiente local" }
  ],
  "tags": [
    { "name": "Auth", "description": "Autenticação" },
    { "name": "Users", "description": "Usuárias, bebês, endereços e consentimento" },
    { "name": "Donations", "description": "Doações, etapas e pontos de doação" },
    { "name": "Jobs", "description": "Agenda interna de coleta/entrega" },
    { "name": "Dashboard", "description": "Métricas agregadas" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSizeParam": {
        "name": "page_size",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 25 }
      }
    },
    "schemas": {
      "ErrorRes": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "DeleteRes": {
        "type": "object",
        "properties": { "success": { "type": "boolean" } }
      },
      "PaginationRes": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "EnumUserType": { "type": "string", "enum": ["common", "adm", "nurse"] },
      "EnumDonationSteps": {
        "type": "string",
        "enum": ["Exame de sangue", "Entregar kit de ordenha", "Coletar leite", "Análise de leite"]
      },
      "EnumDonationStepStatus": {
        "type": "string",
        "enum": ["pending", "review", "done", "warn", "failed"]
      },
      "EnumJobStatus": { "type": "string", "enum": ["pending", "done", "failed"] },

      "UserOut": {
        "type": "object",
        "properties": {
          "id_user": { "type": "string" },
          "internal_identifier": { "type": "string", "nullable": true },
          "type": { "$ref": "#/components/schemas/EnumUserType" },
          "name": { "type": "string" },
          "cpf": { "type": "string" },
          "birth_date": { "type": "string", "format": "date-time" },
          "phone_number": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "milk_donated": { "type": "number", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_by": { "type": "string", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true },
          "removed_by": { "type": "string", "nullable": true }
        }
      },
      "AddressOut": {
        "type": "object",
        "properties": {
          "id_address": { "type": "string" },
          "id_user": { "type": "string", "nullable": true },
          "id_donation_point": { "type": "string", "nullable": true },
          "zipcode": { "type": "string" },
          "street": { "type": "string" },
          "number": { "type": "string", "nullable": true },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "neighborhood": { "type": "string" },
          "complement": { "type": "string", "nullable": true },
          "latitude": { "type": "number", "nullable": true },
          "longitude": { "type": "number", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "UserBabyOut": {
        "type": "object",
        "properties": {
          "id_user_baby": { "type": "string" },
          "id_user": { "type": "string" },
          "name": { "type": "string", "nullable": true },
          "birth_date": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ConsentLogOut": {
        "type": "object",
        "properties": {
          "id_consent_log": { "type": "string" },
          "id_user": { "type": "string" },
          "terms_version": { "type": "string" },
          "accepted_at": { "type": "string", "format": "date-time" },
          "ip_address": { "type": "string" },
          "user_agent": { "type": "string" }
        }
      },
      "DonationOut": {
        "type": "object",
        "properties": {
          "id_donation": { "type": "string" },
          "is_active": { "type": "boolean" },
          "quantity_donated": { "type": "number", "nullable": true },
          "user_feedback": { "type": "string", "nullable": true },
          "score_feedback": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_by": { "type": "string", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true },
          "removed_by": { "type": "string", "nullable": true }
        }
      },
      "DonationStepOut": {
        "type": "object",
        "properties": {
          "id_donation_step": { "type": "string" },
          "id_donation": { "type": "string" },
          "id_address": { "type": "string", "nullable": true },
          "name": { "$ref": "#/components/schemas/EnumDonationSteps" },
          "description": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EnumDonationStepStatus" },
          "set_date": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_by": { "type": "string", "nullable": true },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "DonationStepTimelineOut": {
        "type": "object",
        "properties": {
          "id_donation_step_timeline": { "type": "string" },
          "id_donation_step": { "type": "string" },
          "id_address": { "type": "string", "nullable": true },
          "description": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EnumDonationStepStatus" },
          "set_date": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" }
        }
      },
      "DonationPointOut": {
        "type": "object",
        "properties": {
          "id_donation_point": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "has_home": { "type": "boolean" },
          "phone_number": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "opening_hours": { "type": "string", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "JobOut": {
        "type": "object",
        "properties": {
          "id_job": { "type": "string" },
          "id_user": { "type": "string" },
          "id_step": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EnumJobStatus" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "date_set": { "type": "string", "format": "date-time", "nullable": true },
          "user_feedback": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "updated_by": { "type": "string", "nullable": true },
          "removed_at": { "type": "string", "format": "date-time", "nullable": true },
          "removed_by": { "type": "string", "nullable": true }
        }
      },

      "AddressCreateBase": {
        "type": "object",
        "required": ["zip_code"],
        "properties": {
          "zip_code": { "type": "string", "example": "01001000" },
          "number": { "type": "string", "nullable": true },
          "complement": { "type": "string", "nullable": true }
        }
      },
      "UserBabyCreateBase": {
        "type": "object",
        "required": ["birth_date"],
        "properties": {
          "name": { "type": "string", "nullable": true },
          "birth_date": { "type": "string", "format": "date", "example": "2024-01-01" }
        }
      },
      "CreateConsentBase": {
        "type": "object",
        "required": ["terms_version", "ip_address", "user_agent"],
        "properties": {
          "terms_version": { "type": "string" },
          "ip_address": { "type": "string", "format": "ipv4" },
          "user_agent": { "type": "string" }
        }
      },

      "LoginReq": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      },
      "LoginRes": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "id_user": { "type": "string" },
          "name": { "type": "string" },
          "type": { "$ref": "#/components/schemas/EnumUserType" }
        }
      },

      "CreateUserReq": {
        "type": "object",
        "required": ["type", "name", "cpf", "email", "password", "phone_number"],
        "properties": {
          "type": { "$ref": "#/components/schemas/EnumUserType" },
          "name": { "type": "string", "maxLength": 120 },
          "cpf": { "type": "string", "description": "CPF válido, apenas dígitos" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "phone_number": { "type": "string", "description": "Formato E.164, ex: +5511991111111" },
          "birth_date": { "type": "string", "format": "date", "nullable": true, "description": "Obrigatório para type=common" },
          "address": { "allOf": [{ "$ref": "#/components/schemas/AddressCreateBase" }], "nullable": true, "description": "Obrigatório para type=common" },
          "user_baby": { "type": "array", "items": { "$ref": "#/components/schemas/UserBabyCreateBase" }, "maxItems": 20, "nullable": true },
          "consent_log": { "allOf": [{ "$ref": "#/components/schemas/CreateConsentBase" }], "nullable": true, "description": "Obrigatório para type=common" },
          "identifier": { "type": "string", "maxLength": 50, "nullable": true, "description": "Obrigatório para type=adm ou nurse" }
        }
      },
      "UpdateUserReq": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 120, "nullable": true },
          "phone_number": { "type": "string", "nullable": true },
          "email": { "type": "string", "format": "email", "nullable": true },
          "password": { "type": "string", "minLength": 8, "nullable": true }
        }
      },
      "CreateUserBabyReq": {
        "type": "object",
        "required": ["birth_date"],
        "properties": {
          "name": { "type": "string", "nullable": true },
          "birth_date": { "type": "string", "format": "date" }
        }
      },
      "UpdateUserBabyReq": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "birth_date": { "type": "string", "format": "date", "nullable": true }
        }
      },
      "CreateAddressReq": { "$ref": "#/components/schemas/AddressCreateBase" },
      "UpdateAddressReq": {
        "type": "object",
        "properties": {
          "zip_code": { "type": "string", "nullable": true },
          "number": { "type": "string", "nullable": true },
          "complement": { "type": "string", "nullable": true }
        }
      },
      "CreateConsentReq": { "$ref": "#/components/schemas/CreateConsentBase" },

      "GetUserRes": {
        "allOf": [
          { "$ref": "#/components/schemas/UserOut" },
          {
            "type": "object",
            "properties": {
              "donations_completed": { "type": "integer", "nullable": true },
              "current_donation": { "allOf": [{ "$ref": "#/components/schemas/GetDonationRes" }], "nullable": true },
              "addresses": { "type": "array", "items": { "$ref": "#/components/schemas/AddressOut" }, "nullable": true },
              "babies": { "type": "array", "items": { "$ref": "#/components/schemas/UserBabyOut" }, "nullable": true }
            }
          }
        ]
      },
      "ListUsersRes": {
        "type": "object",
        "allOf": [
          { "$ref": "#/components/schemas/PaginationRes" },
          { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserOut" } } } }
        ]
      },

      "CreateDonationStepReq": {
        "type": "object",
        "required": ["id_donation", "name", "description"],
        "properties": {
          "id_donation": { "type": "string" },
          "id_address": { "type": "string", "nullable": true },
          "address": { "allOf": [{ "$ref": "#/components/schemas/AddressCreateBase" }], "nullable": true },
          "name": { "$ref": "#/components/schemas/EnumDonationSteps" },
          "description": { "type": "string" },
          "set_date": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "UpdateDonationStepReq": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "set_date": { "type": "string", "format": "date-time", "nullable": true },
          "status": { "$ref": "#/components/schemas/EnumDonationStepStatus", "nullable": true },
          "id_address": { "type": "string", "nullable": true },
          "address": { "allOf": [{ "$ref": "#/components/schemas/AddressCreateBase" }], "nullable": true }
        }
      },
      "UpdateDonationReq": {
        "type": "object",
        "properties": {
          "is_active": { "type": "boolean", "nullable": true, "description": "Uso administrativo, para encerrar a doação" },
          "quantity_donated": { "type": "number", "exclusiveMinimum": 0, "nullable": true, "description": "Uso administrativo" },
          "user_feedback": { "type": "string", "nullable": true, "description": "Uso da doadora" },
          "score_feedback": { "type": "integer", "minimum": 0, "maximum": 5, "nullable": true, "description": "Uso da doadora" }
        }
      },
      "GetDonationRes": {
        "allOf": [
          { "$ref": "#/components/schemas/DonationOut" },
          { "type": "object", "properties": { "steps": { "type": "array", "items": { "$ref": "#/components/schemas/DonationStepOut" }, "nullable": true } } }
        ]
      },
      "ListDonationRes": {
        "allOf": [
          { "$ref": "#/components/schemas/PaginationRes" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/DonationOut" },
                    {
                      "type": "object",
                      "properties": {
                        "user_name": { "type": "string", "nullable": true },
                        "user_document": { "type": "string", "nullable": true },
                        "current_step": { "$ref": "#/components/schemas/EnumDonationSteps" },
                        "has_error": { "type": "boolean" }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "ListDonationStepTimelineRes": {
        "type": "object",
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/DonationStepTimelineOut" } } }
      },
      "ListDonationPointsRes": {
        "allOf": [
          { "$ref": "#/components/schemas/PaginationRes" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/DonationPointOut" },
                    {
                      "type": "object",
                      "properties": {
                        "address": { "allOf": [{ "$ref": "#/components/schemas/AddressOut" }], "nullable": true },
                        "distance_from_you": { "type": "number", "nullable": true, "description": "km, presente quando latitude/longitude ou zipcode são informados" }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },

      "CreateJobReq": {
        "type": "object",
        "required": ["id_user", "id_step", "name", "description"],
        "properties": {
          "id_user": { "type": "string" },
          "id_step": { "type": "string" },
          "name": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 100 },
          "date_set": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "UpdateJobReq": {
        "type": "object",
        "properties": {
          "id_user": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["done", "failed"], "nullable": true },
          "description": { "type": "string", "maxLength": 100, "nullable": true },
          "date_set": { "type": "string", "format": "date-time", "nullable": true },
          "user_feedback": { "type": "string", "maxLength": 500, "nullable": true }
        }
      },
      "GetJobRes": {
        "allOf": [
          { "$ref": "#/components/schemas/JobOut" },
          {
            "type": "object",
            "properties": {
              "id_user_common": { "type": "string", "nullable": true },
              "id_address": { "type": "string", "nullable": true }
            }
          }
        ]
      },
      "ListJobsRes": {
        "allOf": [
          { "$ref": "#/components/schemas/PaginationRes" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/JobOut" },
                    {
                      "type": "object",
                      "properties": {
                        "user_common_name": { "type": "string", "nullable": true },
                        "user_nurse_name": { "type": "string", "nullable": true },
                        "address": { "allOf": [{ "$ref": "#/components/schemas/AddressOut" }], "nullable": true },
                        "id_donation": { "type": "string", "nullable": true }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },

      "GetDashboardRes": {
        "type": "object",
        "properties": {
          "total_milk_collected": { "type": "number" },
          "milk_collected_by_month": {
            "type": "array",
            "items": { "type": "object", "properties": { "month": { "type": "string" }, "total": { "type": "number" } } }
          },
          "feedback_by_score": {
            "type": "array",
            "items": { "type": "object", "properties": { "score": { "type": "integer" }, "count": { "type": "integer" } } }
          },
          "average_service_time_hours": { "type": "number", "nullable": true },
          "donations_with_error": { "type": "integer" },
          "donor_recurrence_rate": { "type": "number" },
          "active_donations_by_step": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": { "$ref": "#/components/schemas/EnumDonationSteps" },
                "count": { "type": "integer" },
                "percentage": { "type": "number" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/public/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Autentica um usuário e retorna um JWT a ser usado como `Authorization: Bearer <token>` nas rotas `/internal`.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginReq" } } } },
        "responses": {
          "200": { "description": "Login efetuado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRes" } } } },
          "400": { "description": "Credenciais inválidas", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorRes" } } } }
        }
      }
    },
    "/public/user": {
      "post": {
        "tags": ["Users"],
        "summary": "Autocadastro de usuária comum",
        "description": "Cria uma usuária do tipo `common` sem necessidade de autenticação (autocadastro).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserReq" } } } },
        "responses": {
          "201": { "description": "Usuária criada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserOut" } } } },
          "400": { "description": "Dados inválidos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorRes" } } } }
        }
      }
    },
    "/public/donation/point": {
      "get": {
        "tags": ["Donations"],
        "summary": "Listar pontos de doação",
        "description": "Listagem pública dos pontos de doação, com endereço opcional e distância quando `zipcode` ou `latitude`/`longitude` são informados.",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "show_address", "in": "query", "schema": { "type": "boolean" } },
          { "name": "name", "in": "query", "schema": { "type": "string" } },
          { "name": "has_home", "in": "query", "schema": { "type": "boolean" } },
          { "name": "zipcode", "in": "query", "schema": { "type": "string" } },
          { "name": "latitude", "in": "query", "schema": { "type": "number" } },
          { "name": "longitude", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListDonationPointsRes" } } } }
        }
      }
    },

    "/internal/user/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Buscar usuária por id",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IdPathParam" },
